## Real inventory is generated by `terraform apply` (see terraform/outputs.tf) into
## ./hosts.ini, which is gitignored. This example shows the shape it takes.
##
## ansible_user is root because Verda's minimal ubuntu-24.04 image seeds the SSH key
## to root, not to an `ubuntu` user (docs/decisions.md Section 15). Bootstrap identity
## only — hardening creates the admin user and then disables root SSH login.
##
## 3-server RKE2 HA control plane: rke2_server_init bootstraps the etcd cluster,
## rke2_server_join joins the other two. Both are full (schedulable) RKE2 servers.

[mgmt]
routa-mgmt ansible_host=203.0.113.10

[rke2_server_init]
routa-cp-1 ansible_host=203.0.113.11

[rke2_server_join]
routa-cp-2 ansible_host=203.0.113.12
routa-cp-3 ansible_host=203.0.113.13

[rke2_server:children]
rke2_server_init
rke2_server_join

[routa:children]
mgmt
rke2_server

[routa:vars]
ansible_user=root
ansible_ssh_private_key_file=~/.ssh/routa_ed25519
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
