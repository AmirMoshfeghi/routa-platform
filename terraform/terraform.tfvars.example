# Copy to terraform.tfvars (gitignored) and fill in. Do not commit the real file.
#
# `image` now has a default in variables.tf ("ubuntu-24.04", resolved 2026-08-17 —
# see that file's comment for the full candidate list and rationale). Override here
# only if you want a different image; re-verify via `verda images` first, don't guess.

# image = "ubuntu-24.04"

# Uncomment to override the defaults in variables.tf. Sizing was locked in
# docs/decisions.md Section 4.4; the worker type has since moved to CPU.16V.64G
# after CPU.8V.32G left FIN-03 stock (Section 14). Re-check `verda availability
# --location FIN-03` before apply — this list is live and has already changed once.
# location              = "FIN-03"
# mgmt_instance_type    = "CPU.4V.16G"
# worker_instance_type  = "CPU.16V.64G"
# worker_count          = 3
